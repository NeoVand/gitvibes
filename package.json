{
	"name": "gitvibes",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"test": "npm run test:unit && npm run test:e2e",
		"build:index": "node scripts/build-course-index.mjs",
		"build:timeline": "node scripts/build-timeline.mjs && node scripts/build-timeline-thumbs.mjs && node scripts/build-dwell-calibration.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.3",
		"svelte": "^5.51.0",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@isomorphic-git/lightning-fs": "^4.6.3",
		"@langchain/core": "^1.2.3",
		"@langchain/langgraph": "^1.4.8",
		"buffer": "^6.0.3",
		"isomorphic-git": "^1.38.10",
		"lucide-svelte": "^1.0.1",
		"mermaid": "^11.16.0",
		"zod": "^4.4.3"
	}
}
